# Copy to ".env" (same folder as pom.xml) and fill in YOUR values. Never commit .env.
# ===== DATABASE =====
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=webst3;encrypt=false;trustServerCertificate=true;sslProtocol=TLSv1.2;characterEncoding=UTF-8
DB_USERNAME=sa
DB_PASSWORD=change-me
DDL_AUTO=update
SHOW_SQL=false
# ===== SERVER =====
SERVER_PORT=8082
# ===== SMTP (Gmail App Password) =====
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-16-char-app-password
# ===== CLOUDINARY =====
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# ===== SEED ADMIN =====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@iotstar.vn
ADMIN_PASSWORD=123456
